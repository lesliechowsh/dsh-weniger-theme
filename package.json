{
  "name": "dsh-weniger-theme",
  "version": "0.1.4",
  "description": "Weniger — \"less, but better\": a Dieter Rams-inspired theme for the DeepSeek Harness Web GUI. Warm paper whites, hairline borders, one signal-orange accent, squared 0-4px geometry, flat surfaces, one Swiss type stack.",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "weniger-theme.client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "dieter-rams",
    "weniger",
    "braun-style"
  ],
  "author": "lesliechowsh",
  "license": "MIT",
  "homepage": "https://github.com/lesliechowsh/dsh-weniger-theme#readme",
  "bugs": {
    "url": "https://github.com/lesliechowsh/dsh-weniger-theme/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lesliechowsh/dsh-weniger-theme"
  }
}
